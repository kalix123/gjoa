+NS_IMETHODIMP ContentClassifierService::SetScriptletResources(
+    const nsACString& aJson) {
+  MOZ_ASSERT(NS_IsMainThread());
+
+  MOZ_LOG_FMT(gContentClassifierLog, LogLevel::Debug,
+              "SetScriptletResources - size={}", aJson.Length());
+
+  MutexAutoLock lock(mLock);
+  if (mInitPhase != InitPhase::InitSucceeded) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  mScriptletResources = aJson;
+  // UpdateFeatures snapshots this under mLock and applies it on mBuildThread.
+  // A subsequent onListsChanged rebuild picks it up; engines already built
+  // keep their resources until then.
+  return NS_OK;
+}
